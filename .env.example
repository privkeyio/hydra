# Hydra Environment Configuration Example
# Copy this file to .env and fill in your values

# LLM Provider Selection
# Options: venice, anthropic, openai, claude_cli
LLM_PROVIDER=venice

# Optional: Override model (uses provider default if not set)
# LLM_MODEL=qwen-2.5-coder-32b

# Provider-specific API Keys
# Add the key for your chosen provider:

# Venice AI
VENICE_API_KEY=your_venice_api_key_here
# VENICE_BASE_URL=https://api.venice.ai/api/v1  # Optional custom endpoint

# Anthropic Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1  # Optional custom endpoint

# Claude CLI
# CLAUDE_CLI_PATH=/path/to/claude  # Path to claude binary
# CLAUDE_CLI_FLAGS=--flag          # Optional CLI flags

# Generation Parameters (Optional)
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=2048

# Agent Configuration (Optional)
# AGENT_MAX_DEPTH=2
# AGENT_RETRY_ATTEMPTS=2

# Database Configuration
DATABASE_URL=postgresql://hydra:your_secure_password_here@localhost:5432/hydra
POSTGRES_DB=hydra
POSTGRES_USER=hydra
POSTGRES_PASSWORD=your_secure_password_here

# Redis Configuration
REDIS_URL=redis://:your_redis_password_here@localhost:6379/0
REDIS_PASSWORD=your_redis_password_here

# API Configuration
API_PORT=8000
API_KEYS=your_api_key_here,another_key_here

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Environment
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO