# Hydra Environment Configuration Example
# Copy this file to .env and fill in your values

# Claude CLI Configuration
USE_CLAUDE_CLI=true
CLAUDE_CLI_PATH=claude  # Update this to your actual claude path if needed

# Anthropic API Configuration (fallback if CLI not available)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Venice API Configuration (optional)
VENICE_API_KEY=your_venice_api_key_here
USE_VENICE=false

# Environment
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO